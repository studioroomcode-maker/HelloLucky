# Roboflow object-detection model used for live four-leaf scanning.
# Example model id: four-leaf-detector/3
EXPO_PUBLIC_ROBOFLOW_DETECTION_MODEL_ID=
EXPO_PUBLIC_ROBOFLOW_API_KEY=
EXPO_PUBLIC_ROBOFLOW_DETECTION_BASE_URL=https://detect.roboflow.com

# Detection tuning.
EXPO_PUBLIC_ROBOFLOW_DETECTION_MIN_CONFIDENCE=0.55
EXPO_PUBLIC_ROBOFLOW_MAX_BOXES=4

# Update these if your detection model uses a different class name.
EXPO_PUBLIC_ROBOFLOW_TARGET_LABELS=four_leaf,four leaf,four-leaf

# Live scan behavior.
# "vision-snapshot" uses VisionCamera preview plus sampled snapshot detection.
# "native-realtime" is reserved for the future on-device model/plugin path.
EXPO_PUBLIC_LIVE_VISION_ENGINE=vision-snapshot
EXPO_PUBLIC_LIVE_SCAN_INTERVAL_MS=1100
EXPO_PUBLIC_LIVE_FRAME_PROCESSOR_FPS=6
EXPO_PUBLIC_LIVE_SCAN_REQUIRED_STREAK=2
EXPO_PUBLIC_LIVE_SCAN_MAX_MISSED_FRAMES=1
EXPO_PUBLIC_LIVE_SCAN_IOU_THRESHOLD=0.18
EXPO_PUBLIC_LIVE_SCAN_SMOOTHING=0.55
EXPO_PUBLIC_LIVE_SCAN_MAX_TRACKS=4

# --- On-device detector (native-realtime engine) ---
# 활성화하려면: (1) assets/model/ 또는 기기에 clover.tflite 준비
#   (2) 아래 MODEL_URI 지정  (3) ENGINE 을 native-realtime 으로
#   (4) docs/on-device-detector.md 의 CameraScreen 연결 절차 수행  (5) 네이티브 재빌드
# 모델 파일 경로(file:// URI). 비어 있으면 온디바이스 엔진은 비활성.
EXPO_PUBLIC_ONDEVICE_MODEL_URI=
# YOLO export 의 imgsz 와 일치. (640→NUM_ANCHORS 8400, 320→2100, 1280→33600)
EXPO_PUBLIC_ONDEVICE_INPUT_SIZE=640
EXPO_PUBLIC_ONDEVICE_NUM_ANCHORS=8400
EXPO_PUBLIC_ONDEVICE_NUM_CLASSES=1
# ultralytics tflite 는 보통 정규화 좌표(true). 픽셀이면 false 로.
EXPO_PUBLIC_ONDEVICE_COORDS_NORMALIZED=true
EXPO_PUBLIC_ONDEVICE_MIN_CONFIDENCE=0.4
EXPO_PUBLIC_ONDEVICE_IOU=0.45
# iOS CoreML / Android GPU 델리게이트 시도 (실패 시 CPU 폴백).
EXPO_PUBLIC_ONDEVICE_GPU=true
