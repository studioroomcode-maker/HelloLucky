{
  "expo": {
    "name": "Hello Luck",
    "slug": "HelloLucky",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hellolucky",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json",
      "ja": "./locales/ja.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "zh-Hant": "./locales/zh-Hant.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "pt": "./locales/pt.json",
      "it": "./locales/it.json",
      "ru": "./locales/ru.json",
      "id": "./locales/id.json",
      "vi": "./locales/vi.json",
      "th": "./locales/th.json",
      "ar": "./locales/ar.json",
      "sw": "./locales/sw.json"
    },
    "ios": {
      "bundleIdentifier": "com.studioroomkr.HelloLucky",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "Hello Luck uses the camera to find luck in clover patches. Video is analyzed on your device only.",
        "NSPhotoLibraryUsageDescription": "Hello Luck uses your photos only when you share a luck card to an app like Instagram, so the card can be passed along.",
        "NSPhotoLibraryAddUsageDescription": "Hello Luck saves your luck card to your photos when you choose Save Image."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBik2AW9yiW0K4V4cui2fxzgWs37flJe84"
      }
    },
    "android": {
      "package": "com.studioroomkr.HelloLucky",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#20893C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_PHONE_STATE"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBik2AW9yiW0K4V4cui2fxzgWs37flJe84"
        }
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Hello Luck uses your photos only when you share a luck card to an app like Instagram, so the card can be passed along.",
          "savePhotosPermission": "Hello Luck saves your luck card or journey video to your photos when you choose to save it.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      ["expo-localization", { "supportsRTL": true }],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Hello Luck uses the camera to find luck in clover patches. Video is analyzed on your device only.",
          "enableMicrophonePermission": false,
          "enableFrameProcessors": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hello Luck saves where you found luck. It is made public only if you share it to the Lucky Map.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableCoreMLDelegate": true,
          "enableAndroidGpuLibraries": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#23BCFC",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#23BCFC"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#20893C"
        }
      ],
      ["expo-audio", { "microphonePermission": false, "recordAudioAndroid": false }],
      ["expo-sensors", { "motionPermission": "Hello Luck uses the motion sensors to keep the detection box steady while you move the camera." }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "791c8bd6-6897-49b9-97e7-1912cdbb042d"
      }
    },
    "owner": "sungkyun"
  }
}
